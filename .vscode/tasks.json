{
  "version": "2.0.0",
  "tasks": [
    {
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "label": "Flutter test coverage",
      "type": "shell",
      "options": {
        "cwd": "${workspaceFolder}/client"
      },
      "command": "fvm",
      "args": [
        "flutter",
        "test",
        "--coverage",
        "--dart-define",
        "CI=true",
        "test/test_bundle.dart",
        "$(scripts/generate_test_bundle.sh)"
      ],
      "problemMatcher": []
    },
    {
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "label": "Generate code",
      "type": "shell",
      "options": {
        "cwd": "${workspaceFolder}/client"
      },
      "command": "fvm",
      "args": ["dart", "run", "build_runner", "build"],
      "problemMatcher": []
    },
    {
      "group": "build",
      "label": "Generate code after GraphQL changes",
      "type": "shell",
      "options": {
        "cwd": "${workspaceFolder}/client"
      },
      "command": "rm -r lib/src/core/graphql/__generated__/ && fvm dart run build_runner build && ./scripts/split_schema_graphql_dart.sh && rm -f lib/src/core/graphql/__generated__/hasura_schema.gql.dart.bak",
      "problemMatcher": []
    },
    {
      "label": "Refresh GraphQL schema from the Ash server",
      "type": "shell",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "command": "client/scripts/refresh_graphql_schema.sh",
      "problemMatcher": []
    }
  ]
}
