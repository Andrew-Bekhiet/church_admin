{
  "folders": [
    {
      "name": "church_admin",
      "path": "."
    },
    {
      "name": "server",
      "path": "./server"
    }
  ],
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "church_admin",
        "request": "launch",
        "type": "dart",
        "cwd": "${workspaceFolder:church_admin}/client",
        "args": [
          "--dart-define-from-file",
          "${workspaceFolder:church_admin}/client/.env"
        ]
      },
      {
        "name": "church_admin (profile mode)",
        "request": "launch",
        "type": "dart",
        "flutterMode": "profile",
        "cwd": "${workspaceFolder:church_admin}/client/",
        "args": [
          "--dart-define-from-file",
          "${workspaceFolder:church_admin}/client/.env.dev"
        ]
      },
      {
        "name": "church_admin (release mode)",
        "request": "launch",
        "type": "dart",
        "flutterMode": "release",
        "cwd": "${workspaceFolder:church_admin}/client/",
        "args": [
          "--dart-define-from-file",
          "${workspaceFolder:church_admin}/client/.env"
        ]
      },
      {
        "name": "church_admin (web debug mode)",
        "request": "launch",
        "type": "dart",
        "cwd": "${workspaceFolder:church_admin}/client/",
        "args": [
          "--web-port",
          "5083",
          "--dart-define-from-file",
          "${workspaceFolder:church_admin}/client/.env.dev"
        ]
      },
      {
        "name": "Debug Build Generator",
        "request": "launch",
        "program": ".dart_tool/build/entrypoint/build.dart",
        "type": "dart",
        "args": [
          "build",
          "--delete-conflicting-outputs"
        ],
        "cwd": "${workspaceFolder:church_admin}/client/"
      },
      {
        "name": "Golden",
        "request": "launch",
        "type": "dart",
        "codeLens": {
          "for": [
            "run-test",
            "run-test-file"
          ]
        },
        "args": [
          "--update-goldens"
        ],
        "cwd": "${workspaceFolder:church_admin}/client/"
      },
      {
        "name": "Debug Migration Script",
        "type": "dart",
        "request": "launch",
        "program": "${workspaceFolder:server}/church_admin_migrator/lib/main.dart",
        "args": [
          "-a",
          "--church-data-credentials",
          "-a",
          "lib/churchdata.json",
          "-a",
          "--meeting-helper-credentials",
          "-a",
          "lib/meetinghelper.json",
          "-a",
          "--church-admin-credentials",
          "-a",
          "lib/church-data-admin.json",
          "-a",
          "--migrate-data",
          "-a",
          "--migrate-storage"
        ]
      }
    ],
    "compounds": []
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "group": {
          "kind": "test",
          "isDefault": true
        },
        "label": "Flutter test coverage",
        "type": "shell",
        "options": {
          "cwd": "${workspaceFolder:church_admin}/client"
        },
        "command": "fvm",
        "args": [
          "flutter",
          "test",
          "--coverage;",
          "flutter",
          "pub",
          "global",
          "run",
          "remove_from_coverage:remove_from_coverage",
          "-f",
          "coverage/lcov.info",
          "-r",
          "'.g.dart$'",
          "-r",
          "'.graphql.dart$'",
          "-r",
          "'.gql.dart$'",
          "-r",
          "'.freezed.dart$'",
          "-r",
          "'__generated__'"
        ],
        "problemMatcher": []
      }
    ]
  },
  "settings": {
    "editor.formatOnPaste": true,
    "editor.formatOnSave": true,
    "editor.formatOnType": true,
    "dart.flutterSdkPath": ".fvm/versions/3.44.6",
    "workbench.colorCustomizations": {
      "activityBar.activeBackground": "#00c9b6",
      "activityBar.activeBorder": "#ca00df",
      "activityBar.background": "#00c9b6",
      "activityBar.foreground": "#15202b",
      "activityBar.inactiveForeground": "#15202b99",
      "activityBarBadge.background": "#ca00df",
      "activityBarBadge.foreground": "#e7e7e7",
      "sash.hoverBorder": "#00c9b6",
      "statusBar.background": "#009688",
      "statusBar.foreground": "#e7e7e7",
      "statusBarItem.hoverBackground": "#00c9b6",
      "statusBarItem.remoteBackground": "#90009f",
      "statusBarItem.remoteForeground": "#e7e7e7",
      "titleBar.activeBackground": "#009688",
      "titleBar.activeForeground": "#e7e7e7",
      "titleBar.inactiveBackground": "#00968899",
      "titleBar.inactiveForeground": "#e7e7e799",
      "commandCenter.border": "#e7e7e799",
      "elixirLS.projectDir": "./backend-beta",
      "activityBarTop.activeBackground": "#00c9b6",
      "activityBarTop.background": "#00c9b6",
      "activityBarTop.foreground": "#15202b",
      "activityBarTop.inactiveForeground": "#15202b99",
      "commandCenter.foreground": "#e7e7e7",
      "statusBar.debuggingBackground": "#009688",
      "statusBar.debuggingForeground": "#e7e7e7"
    },
    "peacock.color": "009688",
    "json.schemas": [
      {
        "fileMatch": [
          "**/metadata.json"
        ],
        "url": "https://github.com/hasura/graphql-engine/raw/refs/heads/master/contrib/metadata-types/src/metadata-schemas/MetadataExport.schema.json"
      }
    ],
    "yaml.schemas": {
      "https://github.com/hasura/graphql-engine/raw/refs/heads/master/contrib/metadata-types/src/metadata-schemas/ActionsYAML.schema.json": "**/actions.yaml",
      "https://github.com/hasura/graphql-engine/raw/refs/heads/master/contrib/metadata-types/src/metadata-schemas/AllowListYAML.schema.json": "**/allow_list.yaml",
      "https://github.com/hasura/graphql-engine/raw/refs/heads/master/contrib/metadata-types/src/metadata-schemas/CronTriggerYAML.schema.json": "**/cron_triggers.yaml",
      "https://github.com/hasura/graphql-engine/raw/refs/heads/master/contrib/metadata-types/src/metadata-schemas/FunctionsYAML.schema.json": "**/functions.yaml",
      "https://github.com/hasura/graphql-engine/raw/refs/heads/master/contrib/metadata-types/src/metadata-schemas/QueryCollectionsYAML.schema.json": "**/query_collections.yaml",
      "https://github.com/hasura/graphql-engine/raw/refs/heads/master/contrib/metadata-types/src/metadata-schemas/RemoteSchemasYAML.schema.json": "**/remote_schemas.yaml",
      "https://github.com/hasura/graphql-engine/raw/refs/heads/master/contrib/metadata-types/src/metadata-schemas/TablesYAML.schema.json": "**/tables.yaml",
      "https://json.schemastore.org/dart-build": [
        "build.yaml",
        "*.build.yaml",
        "build.*.yaml"
      ]
    },
    "autoHide.autoHideSideBar": false,
    "autoHide.autoHidePanel": true,
    "cSpell.words": [
      "Shammas"
    ],
    "sqlfluff.excludeRules": [
      "RF06"
    ],
    "postman.settings.dotenv-detection-notification-visibility": false
  }
}