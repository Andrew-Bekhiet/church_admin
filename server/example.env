POSTGRES_USER=postgres
POSTGRES_PASSWORD=<a password of your choosing>
POSTGRES_PORT=5432

ASH_PORT=8080
# Seed data for a new database: --services, or --scale small|medium for generated sample people too.
ASH_SETUP_ARGS=--services

FIREBASE_PROJECT_ID=church-admin-local
PHOTOS_GCS_BUCKET=church-admin-local.appspot.com
APP_RELEASE_GCS_BUCKET=church-admin-local-releases

# Production only: who signs the photo and APK storage links. iam_sign_blob (the default) signs
# through the IAM Credentials API as GCS_SIGNING_SERVICE_ACCOUNT, or the credentials' client_email,
# and needs iam.serviceAccounts.signBlob on that account; service_account_key signs with the
# private key in GOOGLE_APPLICATION_CREDENTIALS_JSON.
# GCS_URL_SIGNER=iam_sign_blob
# GCS_SIGNING_SERVICE_ACCOUNT=storage-signer@<project>.iam.gserviceaccount.com
