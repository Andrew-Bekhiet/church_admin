{
  "name": "functions",
  "scripts": {
    "lint": "eslint --ext .js,.ts .",
    "build": "bunx --bun tsc",
    "build:watch": "bunx --bun tsc --watch",
    "serve": "bun run build && firebase emulators:start --only functions",
    "shell": "bun run build && firebase functions:shell",
    "start": "bun run shell",
    "deploy": "bun run build && firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "dependencies": {
    "axios": "^1.7.4",
    "blurhash": "^2.0.5",
    "firebase-admin": "^12.2.0",
    "firebase-functions": "^5.0.1",
    "sharp": "^0.33.4",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.8",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^7.13.1",
    "@typescript-eslint/parser": "^7.13.1",
    "eslint": "^8.56.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.29.1",
    "typescript": "^4.9.5"
  },
  "private": true
}
