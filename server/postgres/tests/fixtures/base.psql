create or replace function pg_temp.make_person_type(p_name text, p_is_family_admin boolean default false)
returns uuid
language sql
as $$
    insert into public.person_types (name, is_family_admin)
    values (p_name, p_is_family_admin)
    returning id;
$$;

create or replace function pg_temp.make_family(p_name text default 'family')
returns uuid
language sql
as $$
    insert into public.families (name)
    values (p_name)
    returning id;
$$;

create or replace function pg_temp.make_person(
    p_family_id uuid default null,
    p_person_type_id uuid default null,
    p_name text default 'person'
)
returns uuid
language sql
as $$
    insert into public.persons (name, family_id, person_type_id)
    values (p_name, p_family_id, p_person_type_id)
    returning id;
$$;

create or replace function pg_temp.make_user(p_name text default 'user', p_permissions text[] default '{}')
returns uuid
language plpgsql
as $$
declare
    v_uid uuid;
begin
    insert into auth.users_data (name)
    values (p_name)
    returning uid into v_uid;

    insert into auth.users_permissions (uid, permission)
    select v_uid, unnest(p_permissions);

    return v_uid;
end;
$$;
